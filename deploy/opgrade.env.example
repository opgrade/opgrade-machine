# OpGrade X — réglages de la machine (copier dans /etc/opgrade.env, droits 640 root:opgrade)
OPGRADE_SIMULATION=0
OPGRADE_DATA_DIR=/var/lib/opgrade
OPGRADE_MACHINE_ID=OPGX-001
# Interface servie seulement à l'écran de la machine. Mettre 0.0.0.0 uniquement derrière un
# proxy HTTPS, avec OPGRADE_COOKIE_SECURE=1.
OPGRADE_HOST=127.0.0.1
OPGRADE_PORT=8000

# Caméra : exposition et gain FIXES (reproductibilité). Ajuster avec `python -m opgrade.hardware.check`.
OPGRADE_CAMERA_EXPOSURE_US=20000
OPGRADE_CAMERA_GAIN=1.0
# 1 une fois le plateau rétroéclairé monté et câblé (GPIO 16 par défaut).
OPGRADE_BACKLIGHT=0

# Vérification publique des certificats (QR code) : à activer avec la plateforme centrale.
# OPGRADE_VERIFY_URL=https://verifier.example
# OPGRADE_PUBLIC_VERIFY=0
