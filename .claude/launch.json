{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "opgrade-sim",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "opgrade"],
      "port": 8000
    },
    {
      "name": "opgrade-sim-optics",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "opgrade"],
      "env": { "OPGRADE_SIM_OPTICS": "1" },
      "port": 8000
    }
  ]
}
